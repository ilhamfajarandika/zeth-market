	"item": [
		{
			"name": "Get Payment",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(responseBody);\r",
							"pm.collectionVariables.set(\"paymentMethod\",jsonData.paymentFee[0].paymentMethod);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var moment = require('moment')\r",
							"var jsonData=JSON.parse(pm.request.body); \r",
							"var apiKey= pm.collectionVariables.get(\"apiKey\");\r",
							"var merchantcode = pm.collectionVariables.get(\"merchantCode\");\r",
							"var datetime = moment().format('yyyy-MM-DD HH:mm:ss')\r",
							"var paymentAmount = jsonData[\"amount\"];\r",
							"var hashText= merchantcode + paymentAmount + datetime + apiKey;\r",
							"console.log(hashText)\r",
							"var encryption = CryptoJS.SHA256(hashText).toString();\r",
							"pm.collectionVariables.set(\"datetime\", datetime);\r",
							"postman.setEnvironmentVariable(\"signature\",encryption);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"merchantcode\": \"{{merchantCode}}\",\r\n    \"amount\": \"10000\",\r\n    \"datetime\": \"{{datetime}}\",\r\n    \"signature\": \"{{signature}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/paymentmethod/getpaymentmethod",
					"host": [
						"{{url}}"
					],
					"path": [
						"paymentmethod",
						"getpaymentmethod"
					]
				}
			},
			"response": []
		},
		{
			"name": "Transaction Request",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var moment = require('moment')\r",
							"var merchantOrderId = moment().format('x')\r",
							"pm.collectionVariables.set(\"merchantOrderId\",merchantOrderId);\r",
							"var jsonData = JSON.parse(pm.request.body); \r",
							"var merchantCode = pm.collectionVariables.get(\"merchantCode\");\r",
							"var paymentAmount = jsonData[\"paymentAmount\"];\r",
							"var apiKey = pm.collectionVariables.get(\"apiKey\");\r",
							"var hashText = merchantCode+merchantOrderId+paymentAmount+apiKey;\r",
							"var encryption = CryptoJS.MD5(hashText).toString();\r",
							"\r",
							"postman.setEnvironmentVariable(\"signature\", encryption);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(responseBody);\r",
							"pm.collectionVariables.set(\"reference\",jsonData.reference);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"merchantCode\": \"{{merchantCode}}\",\r\n    \"paymentAmount\": \"20000\",\r\n    \"paymentMethod\": \"{{paymentMethod}}\",\r\n    \"merchantOrderId\": \"{{merchantOrderId}}\",\r\n    \"productDetails\": \"Pembayaran untuk Toko Contoh\",\r\n    \"additionalParam\": \"\",\r\n    \"merchantUserInfo\": \"\",\r\n    \"customerVaName\": \"John Doe\",\r\n    \"email\": \"pelanggan_anda@email.com\",\r\n    \"phoneNumber\": \"08123456789\",\r\n    \"itemDetails\": [\r\n        {\r\n            \"name\": \"Test Item 1\",\r\n            \"price\": 20000,\r\n            \"quantity\": 1\r\n        },\r\n        {\r\n            \"name\": \"Test Item 2\",\r\n            \"price\": 0,\r\n            \"quantity\": 1\r\n        }\r\n    ],\r\n    \"customerDetail\": {\r\n        \"firstName\": \"John\",\r\n        \"lastName\": \"Doe\",\r\n        \"email\": \"pelanggan_anda@email.com\",\r\n        \"phoneNumber\": \"085718159655\",\r\n        \"billingAddress\": {\r\n            \"firstName\": \"John\",\r\n            \"lastName\": \"Doe\",\r\n            \"address\": \"Jl. Kembangan Raya\",\r\n            \"city\": \"Jakarta\",\r\n            \"postalCode\": \"11530\",\r\n            \"phone\": \"085718159655\",\r\n            \"countryCode\": \"ID\"\r\n        },\r\n        \"shippingAddress\": {\r\n            \"firstName\": \"John\",\r\n            \"lastName\": \"Doe\",\r\n            \"address\": \"Jl. Kembangan Raya\",\r\n            \"city\": \"Jakarta\",\r\n            \"postalCode\": \"11530\",\r\n            \"phone\": \"085718159655\",\r\n            \"countryCode\": \"ID\"\r\n        }\r\n    },\r\n    \"callbackUrl\": \"{{mockUrl}}/callback\",\r\n    \"returnUrl\": \"{{mockUrl}}/return\",\r\n    \"signature\": \"{{signature}}\",\r\n    \"expiryPeriod\": 15\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/v2/inquiry",
					"host": [
						"{{url}}"
					],
					"path": [
						"v2",
						"inquiry"
					]
				}
			},
			"response": []
